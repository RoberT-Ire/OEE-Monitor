# Copy to .env only when configuring a real deployment.
MONITOR_DEMO=false
# URL-encode any special characters in the database password.
MONITOR_DATABASE_URL=mysql+pymysql://monitor_reader:CHANGE_ME@localhost:3306/production
MONITOR_SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
MONITOR_USERS_FILE=users.json
MONITOR_SECURE_COOKIE=true
MONITOR_STALE_SECONDS=120

# True only for an isolated database containing illustrative sample records.
MONITOR_SAMPLE_DATA=false
